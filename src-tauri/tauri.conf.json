{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MSync",
  "version": "../package.json",
  "identifier": "com.modesthumanbrands.msync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "dotenvx run -f .env.native -- vp dev",
    "beforeBuildCommand": "dotenvx run -f .env.native -- vp build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": true,
        "url": "/",
        "title": "MSync",
        "width": 750,
        "height": 472,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "D:\\**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/ffmpeg", "bin/ffprobe"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/Modest-Human-Brands/msync/releases/latest/download/latest.json"
      ]
    }
  }
}